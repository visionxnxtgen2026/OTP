PORT=5000
HOST=0.0.0.0
# Database Connection (Local or MongoDB Atlas)
# Local: mongodb://127.0.0.1:27017/dds_auth
# Atlas: mongodb+srv://USERNAME:PASSWORD@CLUSTER/dds_auth?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/dds_auth
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5001

# Firebase Admin SDK Configuration (Optional - defaults to otp-site-80c03)
FIREBASE_PROJECT_ID=otp-site-80c03
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@otp-site-80c03.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

{
  "name": "dds-auth-zogoal",
  "version": "1.0.1",
  "description": "Complete DDS Auth integration for React + Node.js — Secure. Verify. Trust. by Zogoal",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "dds-auth-zogoal": "dist/postinstall.cjs"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "postinstall": "node -e \"try{require('./dist/postinstall.cjs')}catch(e){console.log('DDS Auth: run npx dds-auth-zogoal to configure.')}\""
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs",
      "default": "./dist/react/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "require": "./dist/server/index.cjs",
      "default": "./dist/server/index.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "chalk": "^5.4.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.8.0"
  },
  "keywords": [
    "dds",
    "auth",
    "verification",
    "otp",
    "react",
    "nodejs",
    "security",
    "zogoal",
    "mobile-verification"
  ],
  "author": "Zogoal DDS Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
